# =============================================================================
# Настройки проекта 1С:Предприятие (.dev.env)
# =============================================================================

# Раздел 1. Базовые параметры окружения
USE_EDT=false
INFOBASE_KIND=file
UI_TESTING=off

# Раздел 2. Путь к технологической платформе 1С:Предприятие
# Учебная версия платформы 8.3.27 (бинарники: bin\1cv8t.exe, bin\1cv8ct.exe)
PLATFORM_PATH=D:\1c_app\8.3.27.1508
PLATFORM_VERSION=8.3.27

# Раздел 3. Параметры информационной базы (файловый режим)
INFOBASE_PATH=d:\1с лабы\1С_ЛР4_Файлы\Base1C
IB_USER=
IB_PASSWORD=

# Раздел 4. Параметры исходников и выгрузок
EXPORT_PATH=d:\1с лабы\1С_ЛР4_Файлы\src
NEW_OBJECTS_IN=main_configuration
