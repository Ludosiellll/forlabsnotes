&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Попытка
		ИнспектироватьНаСервере();
	Исключение
		ЗаписьОшибки = Новый ЗаписьТекста("d:\1c_inspect_err.txt", КодировкаТекста.UTF8);
		ЗаписьОшибки.ЗаписатьСтроку(ОписаниеОшибки());
		ЗаписьОшибки.Закрыть();
	КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервере
Процедура ИнспектироватьНаСервере()
	Запись = Новый ЗаписьТекста("d:\1с лабы\1С_ЛР4_Манжура\catalogs_dump.txt", КодировкаТекста.UTF8);
	
	Запись.ЗаписатьСтроку("=== СОТРУДНИКИ ===");
	Выб = Справочники.Сотрудники.Выбрать();
	Пока Выб.Следующий() Цикл
		Запись.ЗаписатьСтроку(СокрЛП(Выб.Код) + " | " + СокрЛП(Выб.Наименование));
	КонецЦикла;
	
	Запись.ЗаписатьСтроку("=== СКЛАДЫ ===");
	Выб = Справочники.Склады.Выбрать();
	Пока Выб.Следующий() Цикл
		Запись.ЗаписатьСтроку(СокрЛП(Выб.Код) + " | " + СокрЛП(Выб.Наименование));
	КонецЦикла;
	
	Запись.ЗаписатьСтроку("=== ПОСТАВЩИКИ ===");
	Выб = Справочники.Поставщики.Выбрать();
	Пока Выб.Следующий() Цикл
		Запись.ЗаписатьСтроку(СокрЛП(Выб.Код) + " | " + СокрЛП(Выб.Наименование));
	КонецЦикла;
	
	Запись.ЗаписатьСтроку("=== НОМЕНКЛАТУРА ===");
	Выб = Справочники.Номенклатура.Выбрать();
	Пока Выб.Следующий() Цикл
		Запись.ЗаписатьСтроку(СокрЛП(Выб.Код) + " | " + СокрЛП(Выб.Наименование) + " | ЭтоГруппа: " + Выб.ЭтоГруппа);
	КонецЦикла;
	
	Запись.Закрыть();
КонецПроцедуры
