&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Попытка
		ЗаполнитьВсеДокументыНаСервере();
	Исключение
		ЗаписьОшибки = Новый ЗаписьТекста("d:\\1c_seed_err.txt", КодировкаТекста.UTF8);
		ЗаписьОшибки.ЗаписатьСтроку(ОписаниеОшибки());
		ЗаписьОшибки.Закрыть();
	КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВсеДокументыНаСервере()
	
	// Очищаем ранее созданные документы для чистоты нумерации
	Выборка = Документы.АктСписания.Выбрать();
	Пока Выборка.Следующий() Цикл
		Об = Выборка.ПолучитьОбъект();
		Об.Удалить();
	КонецЦикла;
	
	Выборка = Документы.ОказаниеУслуг.Выбрать();
	Пока Выборка.Следующий() Цикл
		Об = Выборка.ПолучитьОбъект();
		Об.Удалить();
	КонецЦикла;
	
	Выборка = Документы.ПриходнаяНакладная.Выбрать();
	Пока Выборка.Следующий() Цикл
		Об = Выборка.ПолучитьОбъект();
		Об.Удалить();
	КонецЦикла;

	// Получаем склады
	СкладыМассив = Новый Массив;
	ВыборкаСкладов = Справочники.Склады.Выбрать();
	Пока ВыборкаСкладов.Следующий() Цикл
		СкладыМассив.Добавить(ВыборкаСкладов.Ссылка);
	КонецЦикла;
	Если СкладыМассив.Количество() = 0 Тогда
		СкладНовый = Справочники.Склады.СоздатьЭлемент();
		СкладНовый.Наименование = "Основной";
		СкладНовый.Записать();
		СкладыМассив.Добавить(СкладНовый.Ссылка);
	КонецЕсли;

	// Получаем поставщиков
	ПоставщикиМассив = Новый Массив;
	ВыборкаПост = Справочники.Поставщики.Выбрать();
	Пока ВыборкаПост.Следующий() Цикл
		ПоставщикиМассив.Добавить(ВыборкаПост.Ссылка);
	КонецЦикла;
	Если ПоставщикиМассив.Количество() = 0 Тогда
		ПостНовый = Справочники.Поставщики.СоздатьЭлемент();
		ПостНовый.Наименование = "ОАО «Белшина»";
		ПостНовый.Записать();
		ПоставщикиМассив.Добавить(ПостНовый.Ссылка);
	КонецЕсли;

	// Мастер - Манжура Платон Борисович
	МастерМанжура = Справочники.Сотрудники.НайтиПоНаименованию("Манжура Платон Борисович");
	Если МастерМанжура.Пустая() Тогда
		МастерМанжура = Справочники.Сотрудники.НайтиПоНаименованию("Манжура П.Б.");
	КонецЕсли;
	Если МастерМанжура.Пустая() Тогда
		// Создаем сотрудника Манжура Платон Борисович
		СотрНовый = Справочники.Сотрудники.СоздатьЭлемент();
		СотрНовый.Наименование = "Манжура Платон Борисович";
		СотрНовый.Пол = "Мужской";
		Попытка
			СотрНовый.ВидПриемаНаРаботу = Справочники.ВидПриемаНаРаботу.Штатный;
		Исключение
		КонецПопытки;
		СотрНовый.Записать();
		МастерМанжура = СотрНовый.Ссылка;
	КонецЕсли;

	// Номенклатура
	НоменклатураМассив = Новый Массив;
	ВыборкаНом = Справочники.Номенклатура.Выбрать();
	Пока ВыборкаНом.Следующий() Цикл
		Если Не ВыборкаНом.ЭтоГруппа Тогда
			НоменклатураМассив.Добавить(ВыборкаНом.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Если НоменклатураМассив.Количество() = 0 Тогда
		НомНовый = Справочники.Номенклатура.СоздатьЭлемент();
		НомНовый.Наименование = "Шестерня привода";
		НомНовый.Записать();
		НоменклатураМассив.Добавить(НомНовый.Ссылка);
	КонецЕсли;

	// ========================================================
	// 1. Создаем 15 документов "ПриходнаяНакладная"
	// ========================================================
	МассивПН = Новый Массив;
	Для Инд = 1 По 15 Цикл
		Док = Документы.ПриходнаяНакладная.СоздатьДокумент();
		Док.Дата = Дата(2026, 9, Инд, 9 + (Инд % 8), 0, 0);
		Док.Склад = СкладыМассив[(Инд - 1) % СкладыМассив.Количество()];
		Док.Поставщик = ПоставщикиМассив[(Инд - 1) % ПоставщикиМассив.Количество()];
		Док.Комментарий = "Поступление материалов и комплектующих по партии № " + Инд;

		// 1-3 строки ТЧ Материалы
		КолСтрок = 1 + (Инд % 3);
		Для СтрИнд = 1 По КолСтрок Цикл
			Стр = Док.Материалы.Добавить();
			НомИнд = ((Инд + СтрИнд) % НоменклатураМассив.Количество());
			Стр.Наименование = НоменклатураМассив[НомИнд];
			Стр.Количество = 10 * СтрИнд + Инд * 2;
			Стр.Цена = 5.50 + Инд * 2.25;
			Стр.НДС = 20.00;
			Стр.Сумма = Стр.Количество * Стр.Цена;
			Стр.СуммаНДС = Окр(Стр.Сумма * 20 / 120, 2);
			Стр.Наценка = 15.00 + (Инд % 10);
			Стр.СуммаСНаценкой = Окр(Стр.Сумма * (1 + Стр.Наценка / 100), 2);
			Стр.Отклонение = 0.00;
		КонецЦикла;

		Док.Записать(РежимЗаписиДокумента.Запись);
		МассивПН.Добавить(Док.Ссылка);
	КонецЦикла;

	// ========================================================
	// 2. Создаем 15 документов "ОказаниеУслуг" (Нумератор 1..15)
	// ========================================================
	МассивОУ = Новый Массив;
	Для Инд = 1 По 15 Цикл
		Док = Документы.ОказаниеУслуг.СоздатьДокумент();
		Док.Дата = Дата(2026, 9, 10 + (Инд % 15), 10 + (Инд % 7), 15, 0);
		Док.Склад = СкладыМассив[(Инд) % СкладыМассив.Количество()];
		Док.Мастер = МастерМанжура;
		Док.Клиент = ПоставщикиМассив[(Инд + 1) % ПоставщикиМассив.Количество()];

		КолСтрок = 1 + ((Инд + 1) % 3);
		Для СтрИнд = 1 По КолСтрок Цикл
			Стр = Док.ПереченьНоменклатуры.Добавить();
			НомИнд = ((Инд * 2 + СтрИнд) % НоменклатураМассив.Количество());
			Стр.Наименование = НоменклатураМассив[НомИнд];
			Стр.Количество = 1 + СтрИнд;
			Стр.Цена = 25.00 + Инд * 5.00;
			Стр.Сумма = Стр.Количество * Стр.Цена;
			Стр.Стоимость = Стр.Сумма;
		КонецЦикла;

		Док.Записать(РежимЗаписиДокумента.Запись);
		МассивОУ.Добавить(Док.Ссылка);
	КонецЦикла;

	// ========================================================
	// 3. Создаем 6 документов "АктСписания" НА ОСНОВАНИИ "ОказаниеУслуг"
	// ========================================================
	ИндексыОснований = Новый Массив;
	ИндексыОснований.Добавить(0);  // ОказаниеУслуг № 1
	ИндексыОснований.Добавить(2);  // ОказаниеУслуг № 3
	ИндексыОснований.Добавить(4);  // ОказаниеУслуг № 5
	ИндексыОснований.Добавить(6);  // ОказаниеУслуг № 7
	ИндексыОснований.Добавить(8);  // ОказаниеУслуг № 9
	ИндексыОснований.Добавить(10); // ОказаниеУслуг № 11

	Для Каждого ИндОсн Из ИндексыОснований Цикл
		СсылкаОУ = МассивОУ[ИндОсн];
		ДокАС = Документы.АктСписания.СоздатьДокумент();
		ДокАС.Заполнить(СсылкаОУ);
		ДокАС.Дата = СсылкаОУ.Дата + 7200; // на 2 часа позже оказания услуг
		ДокАС.Мастер = МастерМанжура;
		ДокАС.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла;

	// Фиксируем статистику
	ЗаписьТекста = Новый ЗаписьТекста("d:\\1с лабы\\1С_ЛР4_Манжура\\doc_stats.txt", КодировкаТекста.UTF8);
	ЗаписьТекста.ЗаписатьСтроку("Создано документов ПриходнаяНакладная: " + МассивПН.Количество());
	ЗаписьТекста.ЗаписатьСтроку("Создано документов ОказаниеУслуг: " + МассивОУ.Количество());
	ЗаписьТекста.ЗаписатьСтроку("Создано документов АктСписания (на основании ОУ): " + ИндексыОснований.Количество());
	ЗаписьТекста.Закрыть();

КонецПроцедуры
