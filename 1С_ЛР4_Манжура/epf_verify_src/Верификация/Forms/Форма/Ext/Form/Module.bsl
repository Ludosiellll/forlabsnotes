&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Попытка
		ВерифицироватьНаСервере();
	Исключение
		ЗаписьОшибки = Новый ЗаписьТекста("d:\\1c_ver_err.txt", КодировкаТекста.UTF8);
		ЗаписьОшибки.ЗаписатьСтроку(ОписаниеОшибки());
		ЗаписьОшибки.Закрыть();
	КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервере
Процедура ВерифицироватьНаСервере()
	Запись = Новый ЗаписьТекста("d:\\1с лабы\\1С_ЛР4_Манжура\\docs_verify.txt", КодировкаТекста.UTF8);
	
	Запись.ЗаписатьСтроку("=== ПРИХОДНАЯ НАКЛАДНАЯ ===");
	Выб = Документы.ПриходнаяНакладная.Выбрать();
	Пока Выб.Следующий() Цикл
		Запись.ЗаписатьСтроку("№ " + СокрЛП(Выб.Номер) + " от " + Формат(Выб.Дата, "ДФ=dd.MM.yyyy") + " | Склад: " + СокрЛП(Выб.Склад) + " | Поставщик: " + СокрЛП(Выб.Поставщик) + " | Строк ТЧ: " + Выб.Материалы.Количество());
	КонецЦикла;
	
	Запись.ЗаписатьСтроку("=== ОКАЗАНИЕ УСЛУГ ===");
	Выб = Документы.ОказаниеУслуг.Выбрать();
	Пока Выб.Следующий() Цикл
		Запись.ЗаписатьСтроку("№ " + СокрЛП(Выб.Номер) + " от " + Формат(Выб.Дата, "ДФ=dd.MM.yyyy") + " | Мастер: " + СокрЛП(Выб.Мастер) + " | Клиент: " + СокрЛП(Выб.Клиент) + " | Строк ТЧ: " + Выб.ПереченьНоменклатуры.Количество());
	КонецЦикла;
	
	Запись.ЗаписатьСтроку("=== АКТ СПИСАНИЯ ===");
	Выб = Документы.АктСписания.Выбрать();
	Пока Выб.Следующий() Цикл
		Запись.ЗаписатьСтроку("№ " + СокрЛП(Выб.Номер) + " от " + Формат(Выб.Дата, "ДФ=dd.MM.yyyy") + " | Мастер: " + СокрЛП(Выб.Мастер) + " | Комментарий: " + СокрЛП(Выб.Комментарий) + " | Строк ТЧ: " + Выб.ПереченьСписания.Количество());
	КонецЦикла;
	
	Запись.Закрыть();
КонецПроцедуры
