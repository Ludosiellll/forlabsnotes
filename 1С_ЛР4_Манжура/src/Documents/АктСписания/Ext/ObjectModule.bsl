#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ОказаниеУслуг") Тогда
		Мастер = ДанныеЗаполнения.Мастер;
		Комментарий = "Списание по документу Оказание услуг № " + СокрЛП(ДанныеЗаполнения.Номер) + " от " + Формат(ДанныеЗаполнения.Дата, "ДФ=dd.MM.yyyy");
		
		ПереченьСписания.Очистить();
		Для Каждого Стр Из ДанныеЗаполнения.ПереченьНоменклатуры Цикл
			НоваяСтрока = ПереченьСписания.Добавить();
			НоваяСтрока.Наименование = Стр.Наименование;
			НоваяСтрока.Количество   = Стр.Количество;
			НоваяСтрока.Комментарий  = "Списание под оказание услуг";
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		Комментарий = "Списание по накладной № " + СокрЛП(ДанныеЗаполнения.Номер) + " от " + Формат(ДанныеЗаполнения.Дата, "ДФ=dd.MM.yyyy");
		
		ПереченьСписания.Очистить();
		Для Каждого Стр Из ДанныеЗаполнения.Материалы Цикл
			НоваяСтрока = ПереченьСписания.Добавить();
			НоваяСтрока.Наименование = Стр.Наименование;
			НоваяСтрока.Количество   = Стр.Количество;
			НоваяСтрока.Комментарий  = "Списание поступивших материалов";
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
