#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		Склад = ДанныеЗаполнения.Склад;
		Клиент = ДанныеЗаполнения.Поставщик;
		
		ПереченьНоменклатуры.Очистить();
		Для Каждого Стр Из ДанныеЗаполнения.Материалы Цикл
			НоваяСтрока = ПереченьНоменклатуры.Добавить();
			НоваяСтрока.Наименование = Стр.Наименование;
			НоваяСтрока.Количество   = Стр.Количество;
			НоваяСтрока.Цена         = Стр.Цена;
			НоваяСтрока.Сумма        = Стр.Сумма;
			НоваяСтрока.Стоимость    = Стр.Сумма;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
