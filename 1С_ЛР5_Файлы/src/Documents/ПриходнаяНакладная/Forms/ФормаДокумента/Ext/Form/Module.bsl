#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Дополнительное задание 1. Выделить другим цветом ячейку «Сумма»
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	
	// Оформление: светло-зеленый фон ячейки «Сумма»
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.СветлоЗеленый);
	
	// Условие (отбор): Сумма >= 0
	Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Материалы.Сумма");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	Отбор.ПравоеЗначение = 0;
	Отбор.Использование = Истина;
	
	// Оформляемое поле: колонка «МатериалыСумма»
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("МатериалыСумма");
	ПолеОформления.Использование = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура МатериалыКоличествоПриИзменении(Элемент)
	
	СтрТабЧасти = Элементы.Материалы.ТекущиеДанные;
	Если СтрТабЧасти <> Неопределено Тогда
		// Задание 1. Локальный расчет суммы при изменении количества
		// СтрТабЧасти.Сумма = СтрТабЧасти.Количество * СтрТабЧасти.Цена;
		
		// Задание 2 и доп. задание 3. Вызов общего модуля РаботаСДокументами
		РаботаСДокументами.РасчетСуммы(СтрТабЧасти);
		РаботаСДокументами.РасчетНДС(СтрТабЧасти);
		РаботаСДокументами.РасчетСуммыСНаценкой(СтрТабЧасти);
		РаботаСДокументами.РасчетОтклонения(СтрТабЧасти);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЦенаПриИзменении(Элемент)
	
	СтрТабЧасти = Элементы.Материалы.ТекущиеДанные;
	Если СтрТабЧасти <> Неопределено Тогда
		// Задание 1. Локальный расчет суммы при изменении цены
		// СтрТабЧасти.Сумма = СтрТабЧасти.Количество * СтрТабЧасти.Цена;
		
		// Задание 2 и доп. задание 3. Вызов общего модуля РаботаСДокументами
		РаботаСДокументами.РасчетСуммы(СтрТабЧасти);
		РаботаСДокументами.РасчетНДС(СтрТабЧасти);
		РаботаСДокументами.РасчетСуммыСНаценкой(СтрТабЧасти);
		РаботаСДокументами.РасчетОтклонения(СтрТабЧасти);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНДСПриИзменении(Элемент)
	
	СтрТабЧасти = Элементы.Материалы.ТекущиеДанные;
	Если СтрТабЧасти <> Неопределено Тогда
		// Задание 3. Рассчитать автоматически колонку СуммаНДС
		РаботаСДокументами.РасчетНДС(СтрТабЧасти);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНаценкаПриИзменении(Элемент)
	
	СтрТабЧасти = Элементы.Материалы.ТекущиеДанные;
	Если СтрТабЧасти <> Неопределено Тогда
		// Задание 4 и доп. задание 2. Рассчитать колонку СуммаСНаценкой и Отклонение
		РаботаСДокументами.РасчетСуммыСНаценкой(СтрТабЧасти);
		РаботаСДокументами.РасчетОтклонения(СтрТабЧасти);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти