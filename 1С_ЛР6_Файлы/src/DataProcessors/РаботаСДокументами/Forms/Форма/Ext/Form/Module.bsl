&НаСервере
Функция СоздатьДокументНаСервере()
	Поступление = Документы.ПриходнаяНакладная.СоздатьДокумент();
	
	// Заполнение шапки документа
	Поступление.Дата = ТекущаяДата();
	Поступление.Поставщик = Справочники.Поставщики.НайтиПоНаименованию("ОАО ""Азот""");
	Поступление.Склад = Справочники.Склады.НайтиПоКоду("000000001");
	Поступление.Комментарий = "#Документ создан автоматически обработкой";
	
	// Табличная часть
	НоваяСтрока = Поступление.Материалы.Добавить();
	НоваяСтрока.Наименование = Справочники.Номенклатура.НайтиПоНаименованию("Транзистор Philips");
	НоваяСтрока.Количество = 10;
	НоваяСтрока.Цена = 97.10;
	НоваяСтрока.НДС = 20;
	НоваяСтрока.Сумма = Окр(НоваяСтрока.Количество * НоваяСтрока.Цена, 2);
	НоваяСтрока.СуммаНДС = Окр(НоваяСтрока.Сумма * НоваяСтрока.НДС / 100, 2);
	НоваяСтрока.Наценка = -3.5;
	НоваяСтрока.СуммаСНаценкой = Окр(НоваяСтрока.Сумма * (1 + НоваяСтрока.Наценка / 100), 2);
	НоваяСтрока.Отклонение = НоваяСтрока.СуммаСНаценкой - НоваяСтрока.Сумма;
	
	Поступление.Записать(РежимЗаписиДокумента.Запись);
	Поступление.Записать(РежимЗаписиДокумента.Проведение);
	Сообщить("Создан и проведен документ: " + Строка(Поступление.Ссылка));
	Возврат Поступление.Ссылка;
КонецФункции

&НаКлиенте
Процедура СоздатьДокумент(Команда)
	ДокСсылка = СоздатьДокументНаСервере();
	ОповеститьОбИзменении(ДокСсылка);
КонецПроцедуры

// Задание 2.1: Отмена проведения документа
&НаСервере
Функция ОтменаПроведенияНаСервере()
	СсылкаНаПриход = Документы.ПриходнаяНакладная.НайтиПоНомеру("00000000004");
	Если Не СсылкаНаПриход.Пустая() Тогда
		Ссылка = СсылкаНаПриход.ПолучитьОбъект();
		Ссылка.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Сообщить("Отменено проведение документа: " + Строка(СсылкаНаПриход));
	КонецЕсли;
	Возврат СсылкаНаПриход;
КонецФункции

&НаКлиенте
Процедура ОтменаПроведения(Команда)
	ДокСсылка = ОтменаПроведенияНаСервере();
	Если ЗначениеЗаполнено(ДокСсылка) Тогда
		ОповеститьОбИзменении(ДокСсылка);
	КонецЕсли;
КонецПроцедуры

// Задание 2.2: Копия документа
&НаСервере
Функция КопияДокументаНаСервере()
	КопияДокумента = Документы.ПриходнаяНакладная.НайтиПоНомеру("00000000004");
	Если Не КопияДокумента.Пустая() Тогда
		Копия = КопияДокумента.Скопировать();
		Копия.Дата = ТекущаяДата();
		Копия.Комментарий = "копия " + Строка(КопияДокумента);
		Копия.Записать(РежимЗаписиДокумента.Проведение);
		Сообщить("Создана копия документа: " + Строка(Копия.Ссылка));
		Возврат Копия.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура КопияДокумента(Команда)
	ДокСсылка = КопияДокументаНаСервере();
	Если ЗначениеЗаполнено(ДокСсылка) Тогда
		ОповеститьОбИзменении(ДокСсылка);
	КонецЕсли;
КонецПроцедуры

// Задание 3: Изменение документа
&НаСервере
Функция ИзменениеДокументаНаСервере()
	СсылкаНаДокумент = Документы.ПриходнаяНакладная.НайтиПоНомеру("00000000005");
	Если СсылкаНаДокумент.Пустая() Тогда
		Сообщить("Документ не найден");
		Возврат Неопределено;
	Иначе
		Приход = СсылкаНаДокумент.ПолучитьОбъект();
		Приход.Поставщик = Справочники.Поставщики.НайтиПоНаименованию("Петров Пётр Иванович");
		Приход.Комментарий = "#Поставщик изменен обработкой";
		Приход.Записать(РежимЗаписиДокумента.Проведение);
		Сообщить("Изменен документ: " + Строка(СсылкаНаДокумент));
		Возврат СсылкаНаДокумент;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ИзменениеДокумента(Команда)
	ДокСсылка = ИзменениеДокументаНаСервере();
	Если ЗначениеЗаполнено(ДокСсылка) Тогда
		ОповеститьОбИзменении(ДокСсылка);
	КонецЕсли;
КонецПроцедуры

// Задание 4.1: Открытие формы документа
&НаСервере
Функция ОткрытьФормуДокументаНаСервере(НомерДокумента)
	ОказаниеУслуг = Документы.ОказаниеУслуг.НайтиПоНомеру(НомерДокумента);
	Если ОказаниеУслуг.Пустая() Тогда
		ОказаниеУслуг = Документы.ОказаниеУслуг.НайтиПоНомеру(Число(НомерДокумента));
	КонецЕсли;
	Возврат ОказаниеУслуг;
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуДокумента(Команда)
	СсылкаНаДокумент = ОткрытьФормуДокументаНаСервере("00003");
	ПараметрыФормы = Новый Структура("Ключ", СсылкаНаДокумент);
	ОткрытьФорму("Документ.ОказаниеУслуг.ФормаОбъекта", ПараметрыФормы);
КонецПроцедуры

// Задание 4.2: Открытие формы списка документа с отбором
&НаСервере
Функция ОткрытиеФормыСпискаНаСервере(Поставщик)
	ПоставщикСсылка = Справочники.Поставщики.НайтиПоНаименованию(Поставщик);
	Возврат ПоставщикСсылка;
КонецФункции

&НаКлиенте
Процедура ОткрытиеФормыСписка(Команда)
	ПараметрПоставщика = Новый Структура;
	ПараметрПоставщика.Вставить("Поставщик", ОткрытиеФормыСпискаНаСервере("ОАО ""Азот"""));
	
	ПараметрОтбора = Новый Структура;
	ПараметрОтбора.Вставить("Отбор", ПараметрПоставщика);
	
	ОткрытьФорму("Документ.ПриходнаяНакладная.ФормаСписка", ПараметрОтбора);
КонецПроцедуры

// Задание 4.3: Блокировка документа
&НаСервере
Функция БлокировкаДокументаНаСервере(НовыйМассив)
	СсылкаНаДокумент = Документы.ПриходнаяНакладная.НайтиПоНомеру("00000000006");
	Если СсылкаНаДокумент.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Продажа = СсылкаНаДокумент.ПолучитьОбъект();
	
	Если Не Продажа.Заблокирован() Тогда
		Продажа.Заблокировать();
		
		Для Каждого Строка Из НовыйМассив Цикл
			НоваяСтрока = Продажа.Материалы.Добавить();
			НоваяСтрока.Наименование = Справочники.Номенклатура.НайтиПоНаименованию(Строка[0]);
			НоваяСтрока.Количество = Строка[1];
			НоваяСтрока.Цена = Строка[2];
			НоваяСтрока.Наценка = Строка[3];
			НоваяСтрока.НДС = 20;
			
			НоваяСтрока.Сумма = Окр(НоваяСтрока.Количество * НоваяСтрока.Цена, 2);
			НоваяСтрока.СуммаНДС = Окр(НоваяСтрока.Сумма * НоваяСтрока.НДС / 100, 2);
			НоваяСтрока.СуммаСНаценкой = Окр(НоваяСтрока.Сумма * (1 + НоваяСтрока.Наценка / 100), 2);
			НоваяСтрока.Отклонение = НоваяСтрока.СуммаСНаценкой - НоваяСтрока.Сумма;
		КонецЦикла;
		
		Продажа.Комментарий = "Документ изменён " + ТекущаяДата();
		Продажа.Записать(РежимЗаписиДокумента.Проведение);
		
		Продажа.Разблокировать();
		Сообщить("Документ " + Строка(СсылкаНаДокумент) + " изменен и разблокирован");
	КонецЕсли;
	Возврат СсылкаНаДокумент;
КонецФункции

&НаКлиенте
Процедура БлокировкаДокумента(Команда)
	ЧислоНовыхСтрок = 0;
	ВвестиЧисло(ЧислоНовыхСтрок, "Введите число вводимых строк", 1, 0);
	
	Если ЧислоНовыхСтрок <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	НовыйМассив = Новый Массив(ЧислоНовыхСтрок, 4);
	
	Для Индекс = 0 По НовыйМассив.ВГраница() Цикл
		МатериалНовый = "";
		КоличествоНовый = 0;
		ЦенаНовый = 0;
		НаценкаНовый = 0;
		Для Индекс2 = 0 По 3 Цикл
			Если Индекс2 = 0 Тогда
				ВвестиСтроку(МатериалНовый, "Введите название материала", 50, Ложь);
				НовыйМассив[Индекс][Индекс2] = МатериалНовый;
			ИначеЕсли Индекс2 = 1 Тогда
				ВвестиЧисло(КоличествоНовый, "Введите количество материала", 6, 4);
				НовыйМассив[Индекс][Индекс2] = КоличествоНовый;
			ИначеЕсли Индекс2 = 2 Тогда
				ВвестиЧисло(ЦенаНовый, "Введите цену материала", 6, 2);
				НовыйМассив[Индекс][Индекс2] = ЦенаНовый;
			ИначеЕсли Индекс2 = 3 Тогда
				ВвестиЧисло(НаценкаНовый, "Введите наценку материала в %", 6, 2);
				НовыйМассив[Индекс][Индекс2] = НаценкаНовый;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого Строка Из НовыйМассив Цикл
		Для Каждого Элемент Из Строка Цикл
			Сообщить(Элемент);
		КонецЦикла;
	КонецЦикла;
	
	ДокСсылка = БлокировкаДокументаНаСервере(НовыйМассив);
	Если ЗначениеЗаполнено(ДокСсылка) Тогда
		ОповеститьОбИзменении(ДокСсылка);
	КонецЕсли;
КонецПроцедуры
