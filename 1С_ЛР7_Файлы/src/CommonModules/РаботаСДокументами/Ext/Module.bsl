Процедура РасчетСуммы(СтрТабЧасти) Экспорт
	Если СтрТабЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрТабЧасти.Сумма = СтрТабЧасти.Количество * СтрТабЧасти.Цена;
КонецПроцедуры

Процедура РассчетСуммы(СтрТабЧасти) Экспорт
	РасчетСуммы(СтрТабЧасти);
КонецПроцедуры

Процедура РасчетНДС(СтрТабЧасти) Экспорт
	Если СтрТабЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрТабЧасти.СуммаНДС = Окр(СтрТабЧасти.Сумма * СтрТабЧасти.НДС / 100, 2);
КонецПроцедуры

Процедура РасчетСуммыСНаценкой(СтрТабЧасти) Экспорт
	Если СтрТабЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрТабЧасти.СуммаСНаценкой = Окр(СтрТабЧасти.Сумма * (1 + СтрТабЧасти.Наценка / 100), 2);
КонецПроцедуры

Процедура РасчетОтклонения(СтрТабЧасти) Экспорт
	Если СтрТабЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрТабЧасти.Отклонение = СтрТабЧасти.СуммаСНаценкой - СтрТабЧасти.Сумма;
КонецПроцедуры

Процедура ПересчитатьСтроку(СтрТабЧасти) Экспорт
	Если СтрТабЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РасчетСуммы(СтрТабЧасти);
	РасчетНДС(СтрТабЧасти);
	РасчетСуммыСНаценкой(СтрТабЧасти);
	РасчетОтклонения(СтрТабЧасти);
КонецПроцедуры
