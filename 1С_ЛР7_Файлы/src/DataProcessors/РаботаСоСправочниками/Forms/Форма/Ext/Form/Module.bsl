#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СозданиеЭлементовСправочника(Команда)
	
	СозданиеЭлементовСправочникаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СозданиеЭлементовСправочникаНаСервере()
	
	Материал = Справочники.Номенклатура.СоздатьЭлемент();
	Материал.Наименование = "Коробка упаковочная";
	Материал.Артикул = "010100";
	Материал.Записать();
	
	Сообщить("Создан элемент: " + Материал.Наименование);
	
КонецПроцедуры

&НаКлиенте
Процедура СозданиеПодчинённогоЭлемента(Команда)
	
	СозданиеПодчинённогоЭлементаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СозданиеПодчинённогоЭлементаНаСервере()
	
	ВладелецЭлемент = Справочники.Номенклатура.НайтиПоНаименованию("Коробка упаковочная");
	Если ВладелецЭлемент.Пустая() Тогда
		Сообщить("Элемент ""Коробка упаковочная"" не найден");
		Возврат;
	КонецЕсли;
	
	Подчиненный = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
	Подчиненный.Владелец = ВладелецЭлемент;
	Подчиненный.Наименование = "Штука";
	Подчиненный.ЕдиницаИзмерения = "шт";
	Подчиненный.Записать();
	
	ЭлементОбъект = ВладелецЭлемент.ПолучитьОбъект();
	ЭлементОбъект.ОсновнаяЕдиницаИзмерения = Подчиненный.Ссылка;
	ЭлементОбъект.Записать();
	
	Сообщить("Создан подчиненный элемент: " + Подчиненный.Наименование);
	
КонецПроцедуры

&НаКлиенте
Процедура СозданиеГруппыСправочника(Команда)
	
	СозданиеГруппыСправочникаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СозданиеГруппыСправочникаНаСервере()
	
	Группа = Справочники.Номенклатура.НайтиПоНаименованию("Материалы");
	Если Группа.Пустая() Тогда
		НоваяГруппа = Справочники.Номенклатура.СоздатьГруппу();
		НоваяГруппа.Наименование = "Материалы";
		НоваяГруппа.Записать();
		Сообщить("Создана группа: " + НоваяГруппа.Наименование);
	Иначе
		Сообщить("Группа ""Материалы"" уже существует");
	КонецЕсли;
	
	ГруппаПрочие = Справочники.Номенклатура.НайтиПоНаименованию("Прочие");
	Если ГруппаПрочие.Пустая() Тогда
		НоваяГруппаПрочие = Справочники.Номенклатура.СоздатьГруппу();
		НоваяГруппаПрочие.Наименование = "Прочие";
		НоваяГруппаПрочие.Записать();
		Сообщить("Создана группа: " + НоваяГруппаПрочие.Наименование);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереносЭлементовВГруппы(Команда)
	
	ПереносЭлементовВГруппыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПереносЭлементовВГруппыНаСервере()
	
	Группа = Справочники.Номенклатура.НайтиПоНаименованию("Материалы");
	ЭлементСсылка = Справочники.Номенклатура.НайтиПоНаименованию("Коробка упаковочная");
	
	Если ЭлементСсылка.Пустая() Тогда
		Сообщить("Элемент ""Коробка упаковочная"" не найден");
		Возврат;
	КонецЕсли;
	
	Если Группа.Пустая() Тогда
		Сообщить("Группа ""Материалы"" не найдена");
		Возврат;
	КонецЕсли;
	
	ЭлементОбъект = ЭлементСсылка.ПолучитьОбъект();
	ЭлементОбъект.Родитель = Группа;
	ЭлементОбъект.Записать();
	
	Сообщить("Элемент перенесен в группу " + Группа.Наименование);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеЭлементаСправочника(Команда)
	
	ИзменениеЭлементаСправочникаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ИзменениеЭлементаСправочникаНаСервере()
	
	ЭлементСсылка = Справочники.Номенклатура.НайтиПоНаименованию("Коробка упаковочная");
	Если ЭлементСсылка.Пустая() Тогда
		Сообщить("Элемент ""Коробка упаковочная"" не найден");
		Возврат;
	КонецЕсли;
	
	ЭлементОбъект = ЭлементСсылка.ПолучитьОбъект();
	ЭлементОбъект.Артикул = "010101";
	ЭлементОбъект.Записать();
	
	Сообщить("Изменен артикул: " + ЭлементОбъект.Артикул);
	
КонецПроцедуры

&НаКлиенте
Процедура КопированиеЭлементовСправочника(Команда)
	
	КопированиеЭлементовСправочникаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура КопированиеЭлементовСправочникаНаСервере()
	
	ЭлементСсылка = Справочники.Номенклатура.НайтиПоНаименованию("Коробка упаковочная");
	Если ЭлементСсылка.Пустая() Тогда
		Сообщить("Элемент ""Коробка упаковочная"" не найден");
		Возврат;
	КонецЕсли;
	
	ЭлементОбъект = ЭлементСсылка.ПолучитьОбъект();
	КопияОбъекта = ЭлементОбъект.Скопировать();
	КопияОбъекта.Наименование = "Коробка упаковочная (копия)";
	КопияОбъекта.Артикул = "010102";
	КопияОбъекта.Записать();
	
	Сообщить("Создана копия элемента: " + КопияОбъекта.Наименование);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьЭлементСправочника(Команда)
	
	ПолучитьЭлементСправочникаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьЭлементСправочникаНаСервере()
	
	ЭлементСсылка = Справочники.Номенклатура.НайтиПоНаименованию("Коробка упаковочная");
	Если Не ЭлементСсылка.Пустая() Тогда
		Сообщить("Получен элемент: " + ЭлементСсылка.Наименование + 
			", Код: " + ЭлементСсылка.Код + 
			", Артикул: " + ЭлементСсылка.Артикул + 
			", Родитель: " + Строка(ЭлементСсылка.Родитель));
	Иначе
		Сообщить("Элемент не найден в справочнике Номенклатура");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СозданиеЭлементаПользовательскийВвод(Команда)
	
	Если ПустаяСтрока(ВводНаименование) Тогда
		Сообщить("Не указано наименование элемента");
		Возврат;
	КонецЕсли;
	
	ИмяСозданного = "";
	ГруппаИмя = "";
	СозданиеЭлементаПользовательскийВводНаСервере(ИмяСозданного, ГруппаИмя);
	
	ПоказатьОповещениеПользователя(
		"Успешно создано",
		,
		"Элемент """ + ИмяСозданного + """ записан в группу """ + ГруппаИмя + """"
	);
	
КонецПроцедуры

&НаСервере
Процедура СозданиеЭлементаПользовательскийВводНаСервере(ИмяСозданного, ГруппаИмя)
	
	ГруппаПрочие = Справочники.Номенклатура.НайтиПоНаименованию("Прочие");
	Если ГруппаПрочие.Пустая() Тогда
		НоваяГруппа = Справочники.Номенклатура.СоздатьГруппу();
		НоваяГруппа.Наименование = "Прочие";
		НоваяГруппа.Записать();
		ГруппаПрочие = НоваяГруппа.Ссылка;
	КонецЕсли;
	
	НовыйЭлемент = Справочники.Номенклатура.СоздатьЭлемент();
	НовыйЭлемент.Наименование = ВводНаименование;
	НовыйЭлемент.Артикул = ?(ПустаяСтрока(ВводАртикул), "010199", ВводАртикул);
	НовыйЭлемент.Родитель = ГруппаПрочие;
	Если ЗначениеЗаполнено(ВводЕдиницаИзмерения) Тогда
		НовыйЭлемент.ОсновнаяЕдиницаИзмерения = ВводЕдиницаИзмерения;
	КонецЕсли;
	НовыйЭлемент.Записать();
	Если Не ЗначениеЗаполнено(НовыйЭлемент.ОсновнаяЕдиницаИзмерения) Тогда
		НовЕд = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
		НовЕд.Владелец = НовыйЭлемент.Ссылка;
		НовЕд.Наименование = "Штука";
		НовЕд.ЕдиницаИзмерения = "шт";
		НовЕд.Записать();
		НовыйЭлемент.ОсновнаяЕдиницаИзмерения = НовЕд.Ссылка;
		НовыйЭлемент.Записать();
	КонецЕсли;
	
	ИмяСозданного = НовыйЭлемент.Наименование;
	ГруппаИмя = ГруппаПрочие.Наименование;
	
	Сообщить("Элемент записан в группу " + ГруппаПрочие.Наименование);
	
КонецПроцедуры

#КонецОбласти
