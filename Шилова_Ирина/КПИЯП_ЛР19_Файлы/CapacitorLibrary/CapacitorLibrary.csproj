<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CapacitorLibrary</RootNamespace>
    <AssemblyName>CapacitorLibrary</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Update="**\*.txt;**\*.csv;**\*.json;**\*.xml;**\*.dat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
